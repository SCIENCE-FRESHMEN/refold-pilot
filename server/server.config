def root = System.getenv('REFOLD_ROOT')
def account = System.getenv('REFOLD_ACCOUNT')
def gpuType = System.getenv('REFOLD_GPU_TYPE') ?: 'L40S'
def gpuFeatures = System.getenv('REFOLD_GPU_FEATURES') ?: ''
def gpuRequest = gpuType == 'auto' ? 'gpu:1' : "gpu:${gpuType}:1"
def gpuConstraint = gpuFeatures ? " --constraint='${gpuFeatures}'" : ''

executor {
    queueSize = 1
    pollInterval = '30 sec'
    queueStatInterval = '2 min'
    submitRateLimit = '1/10sec'
}

process {
    executor = 'slurm'
    clusterOptions = "--account=${account} --partition=comp"
    cpus = 2
    memory = '8 GB'
    time = '1h'
    errorStrategy = 'terminate'
    maxRetries = 0
    cache = 'deep'

    withName: /RFDIFFUSION|AF2_INITIAL_GUESS|BOLTZ_COMPARE_COMPLEX|BOLTZ_COMPARE_BINDER_MONOMER/ {
        executor = 'slurm'
        accelerator = null
        clusterOptions = "--account=${account} --partition=gpu --gres=${gpuRequest}${gpuConstraint}"
        cpus = 4
        memory = '64 GB'
        time = '30 min'
    }
    withName: RFDIFFUSION { container = "${root}/containers/rfd.sif" }
    withName: DL_BINDER_DESIGN_PROTEINMPNN {
        container = "${root}/containers/mpnn.sif"
        cpus = 4
        memory = '16 GB'
    }
    withName: AF2_INITIAL_GUESS { container = "${root}/containers/af2.sif" }
    withName: 'RFD:RFDIFFUSION' { time = '10 min' }
    withName: 'RFD:AF2_INITIAL_GUESS' { time = '10 min' }
    withName: /BOLTZ_COMPARE_COMPLEX|BOLTZ_COMPARE_BINDER_MONOMER/ { container = "${root}/containers/boltz.sif" }
    withName: /BINDCRAFT_SCORING.*/ {
        container = "${root}/containers/scoring.sif"
        cpus = 4
        memory = '16 GB'
    }
    withName: /AF2IG_SCORE_FILTER|COMBINE_SCORES/ {
        container = "${root}/containers/utils.sif"
        executor = 'slurm'
        cpus = 2
        memory = '8 GB'
    }
    withName: SELECT_REFOLD_CANDIDATES {
        executor = 'local'
        container = null
        cpus = 1
        memory = '1 GB'
    }
}

apptainer {
    enabled = true
    autoMounts = true
    cacheDir = "${root}/containers"
    runOptions = "--nv --cleanenv --env PYTHONNOUSERSITE=1 --env CUDA_VISIBLE_DEVICES=\${CUDA_VISIBLE_DEVICES:-} -B ${root}:${root}"
}
docker.enabled = false

trace {
    raw = true
    overwrite = true
    fields = 'task_id,hash,native_id,name,status,exit,duration,realtime,cpus,peak_rss,workdir'
}
report.overwrite = true
timeline.overwrite = true
